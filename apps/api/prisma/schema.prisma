generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(cuid())
  passwordHash       String
  active             Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastLoginAt        DateTime?
  mustChangePassword Boolean    @default(false)
  personId           String     @unique
  roles              UserRole[]
  person             Person    @relation(fields: [personId], references: [id])
    approvedReservations Reservation[] @relation("ReservationApprover")
    reservationStatusChanges ReservationStatusHistory[] @relation("ReservationStatusChanger")
  announcements Announcement[] @relation("AnnouncementAuthor")
  events ClubEvent[] @relation("EventAuthor")
  accessEvents AccessEvent[] @relation("AccessRegistrar")
  paymentRegistrations FinancialPayment[] @relation("FinancialPaymentRegistrar")
  mediaAssets          MediaAsset[] @relation("MediaAssetCreator")

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MemberCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  description String?
  isDependent Boolean @default(false)
  requiresHolder Boolean @default(false)
  annualFeeAmount Decimal? @db.Decimal(12,2)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt
  members   Member[]
  @@map("member_categories")
}

model Member {
  id                 String            @id @default(cuid())
  personId           String            @unique
  categoryId         String
  registrationNumber String            @unique @default(dbgenerated("next_member_registration_number()"))
  admissionDate      DateTime
  status             MemberStatus      @default(ACTIVE)
  notes              String?
  titularMemberId    String?
  relationship       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  titular             Member?           @relation("MemberTitular", fields: [titularMemberId], references: [id])
  dependentes         Member[]          @relation("MemberTitular")
  invitations        VisitorInvitation[]
  quotaOwnerInvitations VisitorInvitation[] @relation("InvitationQuotaOwner")
  charges            FinancialCharge[]
  responsibleCharges FinancialCharge[] @relation("FinancialResponsible")
  reservations       Reservation[]
  category           MemberCategory @relation(fields: [categoryId], references: [id])
  person             Person           @relation(fields: [personId], references: [id])
  @@index([titularMemberId])
  @@map("members")
}

model ReservableSpace {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  capacity         Int?
  price            Decimal  @db.Decimal(12,2)
  active           Boolean  @default(true)
  imagePath        String?
  requiresApproval Boolean  @default(true)
  reservationRules String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  reservations     Reservation[]
  photos           SpacePhoto[]
  @@map("reservable_spaces")
}

model SpacePhoto {
  id        String          @id @default(cuid())
  spaceId   String
  path      String
  mediaAssetId String?
  isPrimary Boolean         @default(false)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  space     ReservableSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation("SpacePhotoAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  @@unique([mediaAssetId])
  @@index([spaceId, sortOrder])
  @@map("space_photos")
}

enum ReservationStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

  model Reservation {
  id               String   @id @default(cuid())
  memberId         String
  spaceId          String
  reservationDate  DateTime
  startTime        String?
  endTime          String?
  status           ReservationStatus @default(REQUESTED)
  totalAmount      Decimal  @db.Decimal(12,2)
  notes            String?
  approvedAt       DateTime?
  approvedByUserId String?
  rejectionReason  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  member           Member @relation(fields:[memberId], references:[id])
  space            ReservableSpace @relation(fields:[spaceId], references:[id])
    approvedBy       User? @relation("ReservationApprover", fields:[approvedByUserId], references:[id])
    statusHistory    ReservationStatusHistory[]
  @@index([spaceId, reservationDate])
    @@map("reservations")
  }

  model ReservationStatusHistory {
    id              String            @id @default(cuid())
    reservationId   String
    fromStatus      ReservationStatus?
    toStatus        ReservationStatus
    changedByUserId String?
    reason          String?
    createdAt       DateTime          @default(now())
    reservation     Reservation       @relation(fields:[reservationId], references:[id], onDelete: Cascade)
    changedBy       User?             @relation("ReservationStatusChanger", fields:[changedByUserId], references:[id], onDelete: SetNull)
    @@index([reservationId, createdAt])
    @@map("reservation_status_history")
  }

enum AnnouncementAudience {
  ALL_MEMBERS
  HOLDERS_ONLY
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaPurpose {
  MEMBER_PHOTO
  SPACE_PHOTO
  ANNOUNCEMENT_IMAGE
  EVENT_IMAGE
  ATTACHMENT
}

model MediaAsset {
  id             String          @id @default(cuid())
  storageKey     String          @unique
  mimeType       String
  sizeBytes      Int
  width          Int?
  height         Int?
  checksumSha256 String
  visibility     MediaVisibility
  purpose        MediaPurpose
  originalName   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  createdByUserId String?
  createdByUser  User?           @relation("MediaAssetCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  personPhoto    Person?         @relation("PersonPhotoAsset")
  spacePhoto     SpacePhoto?     @relation("SpacePhotoAsset")
  announcementImage Announcement? @relation("AnnouncementImageAsset")
  financialDocument FinancialDocument?
  eventImage     ClubEvent?      @relation("EventImageAsset")

  @@index([checksumSha256])
  @@index([visibility, purpose])
  @@index([deletedAt])
  @@map("media_assets")
}

model Announcement {
  id String @id @default(cuid())
  title String
  content String
  startDate DateTime
  endDate DateTime?
  imagePath String?
  imageAssetId String?
  active Boolean @default(true)
  audience AnnouncementAudience @default(ALL_MEMBERS)
  createdByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation("AnnouncementAuthor", fields:[createdByUserId], references:[id])
  imageAsset MediaAsset? @relation("AnnouncementImageAsset", fields:[imageAssetId], references:[id], onDelete: SetNull)
  @@unique([imageAssetId])
  @@map("announcements")
}

model ClubEvent {
  id String @id @default(cuid())
  title String
  description String
  location String?
  startDateTime DateTime
  endDateTime DateTime?
  imagePath String?
  imageAssetId String?
  memberPrice Decimal? @db.Decimal(12,2)
  guestPrice Decimal? @db.Decimal(12,2)
  capacity Int?
  active Boolean @default(true)
  createdByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation("EventAuthor", fields:[createdByUserId], references:[id])
  imageAsset MediaAsset? @relation("EventImageAsset", fields:[imageAssetId], references:[id], onDelete: SetNull)
  @@unique([imageAssetId])
  @@map("club_events")
}

model AccessPoint {
 id String @id @default(cuid())
 name String @unique
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 events AccessEvent[]
 @@map("access_points")
}
enum AccessEventType {
 ENTRY
 EXIT
}
enum AccessMethod {
 QR_CODE
 CPF_SEARCH
 MANUAL
}
model AccessEvent {
 id String @id @default(cuid())
 personId String
 accessPointId String
 type AccessEventType
 method AccessMethod
 invitationId String?
 registeredByUserId String?
 occurredAt DateTime @default(now())
 notes String?
 createdAt DateTime @default(now())
 person Person @relation(fields:[personId],references:[id])
 accessPoint AccessPoint @relation(fields:[accessPointId],references:[id])
 invitation VisitorInvitation? @relation(fields:[invitationId],references:[id])
 registeredBy User? @relation("AccessRegistrar",fields:[registeredByUserId],references:[id])
 @@index([occurredAt])
 @@map("access_events")
}

model Person {
  id         String       @id @default(cuid())
  fullName   String
  cpf        String       @unique
  birthDate  DateTime?
  phone      String?
  email      String?      @unique
  city       String?
  state      String?
  photoPath  String?
  photoAssetId String?
  credentialToken String @unique @default(cuid())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime @updatedAt
  member     Member?
  visitor    Visitor?
  user       User?
  photoAsset MediaAsset? @relation("PersonPhotoAsset", fields:[photoAssetId], references:[id], onDelete: SetNull)
  @@unique([photoAssetId])
  accessEvents AccessEvent[]
  @@map("persons")
}

model Visitor {
  id String @id @default(cuid())
  personId String @unique
  active Boolean @default(true)
  blocked Boolean @default(false)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  person Person @relation(fields: [personId], references: [id])
  invitations VisitorInvitation[]
  @@map("visitors")
}
enum VisitorInvitationStatus {
  SCHEDULED
  USED
  CANCELLED
  EXPIRED
}
model VisitorInvitation {
  id String @id @default(cuid())
  visitorId String
  sponsorMemberId String
  quotaOwnerMemberId String
  scheduledDate DateTime?
  status VisitorInvitationStatus @default(SCHEDULED)
  usedAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visitor Visitor @relation(fields: [visitorId], references: [id])
  sponsorMember Member @relation(fields: [sponsorMemberId], references: [id])
  quotaOwnerMember Member @relation("InvitationQuotaOwner", fields: [quotaOwnerMemberId], references: [id])
  accessEvents AccessEvent[]
  @@index([quotaOwnerMemberId, createdAt, status])
  @@map("visitor_invitations")
}
model ClubSetting {
  id String @id @default(cuid())
  visitorAnnualLimit Int @default(7)
  memberMonthlyInvitationLimit Int @default(8)
  annualLimitMode String @default("SEASON_NOV_OCT")
  invitationConsumptionMode String @default("CHECK_IN")
  annualFeeAmount Decimal @default(1600)
  annualFeePaymentModes String @default("PIX,CREDIT_CARD,MONTHLY_PIX")
  updatedAt DateTime @updatedAt
  @@map("club_settings")
}

enum FinancialChargeType {
  ANNUAL_FEE
  RESERVATION
  EVENT
  OTHER
}
enum FinancialChargeStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}
model FinancialCharge {
  id String @id @default(cuid())
  memberId String
  responsibleMemberId String
  type FinancialChargeType
  description String
  referenceYear Int?
  amount Decimal @db.Decimal(12,2)
  dueDate DateTime
  status FinancialChargeStatus @default(PENDING)
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member Member @relation(fields:[memberId], references:[id])
  responsibleMember Member @relation("FinancialResponsible", fields:[responsibleMemberId], references:[id])
  payments FinancialPayment[]
  settlementReversedAt DateTime?
  settlementReversedByUserId String?
  settlementReversalReason String?
  annualEnrollmentId String?
  installmentNumber Int?
  annualEnrollment AnnualEnrollment? @relation(fields: [annualEnrollmentId], references: [id])
  documents FinancialDocument[]
  @@unique([annualEnrollmentId, installmentNumber])
  @@index([responsibleMemberId, dueDate])
  @@index([dueDate, status])
  @@map("financial_charges")
}

enum FinancialPaymentMethod {
  BOLETO
  PIX
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  OTHER
}

model FinancialPayment {
  id String @id @default(cuid())
  chargeId String
  amount Decimal @db.Decimal(12,2)
  paidAt DateTime @default(now())
  method FinancialPaymentMethod
  notes String?
  reversedAt DateTime?
  reversedByUserId String?
  reversalReason String?
  registeredByUserId String?
  charge FinancialCharge @relation(fields:[chargeId], references:[id], onDelete: Cascade)
  registeredBy User? @relation("FinancialPaymentRegistrar", fields:[registeredByUserId], references:[id], onDelete: SetNull)
  @@index([chargeId, paidAt])
  @@map("financial_payments")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

model AccessAudit {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  actorId      String
  targetUserId String
  action       String
  before       Json
  after        Json

  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@map("access_audits")
}

model ActivityLog {
  id            String @id @default(cuid())
  createdAt     DateTime @default(now())
  actorId       String
  actorName     String
  actorRole     String?
  assignedRoles String[]
  authenticated Boolean @default(true)
  module        String
  action        String
  route         String
  method        String
  targetId      String?
  status        String
  statusCode    Int
  details       Json
  changes       ActivityChange[]
  @@index([createdAt, id])
  @@index([actorId, createdAt])
  @@index([actorRole, module, createdAt])
  @@map("activity_logs")
}
model ActivityChange {
  sequence  Int @unique @default(autoincrement())
  id        String @id @default(cuid())
  logId     String
  tableName String
  recordId  String
  label     String
  operation String
  before    Json
  after     Json
  log       ActivityLog @relation(fields: [logId], references: [id])
  @@index([logId])
  @@map("activity_changes")
}

model AnnualSeason {
  id String @id @default(cuid())
  endYear Int @unique
  amount Decimal @db.Decimal(12,2)
  enrollmentOpen Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  enrollments AnnualEnrollment[]
  @@map("annual_seasons")
}
model AnnualEnrollment {
  id String @id @default(cuid())
  seasonId String
  responsibleMemberId String
  mode String
  amount Decimal @db.Decimal(12,2)
  createdByUserId String
  createdAt DateTime @default(now())
  season AnnualSeason @relation(fields: [seasonId], references: [id])
  charges FinancialCharge[]
  @@unique([seasonId, responsibleMemberId])
  @@map("annual_enrollments")
}
model AnnualPaymentSetting {
  id String @id @default("club")
  pixKey String @default("")
  beneficiary String @default("")
  whatsapp String @default("")
  updatedAt DateTime @updatedAt
  @@map("annual_payment_settings")
}
model FinancialDocument {
  id String @id @default(cuid())
  chargeId String
  kind String
  status String
  mediaAssetId String @unique
  submittedByUserId String
  reviewedByUserId String?
  reviewedAt DateTime?
  rejectionReason String?
  paymentId String? @unique
  createdAt DateTime @default(now())
  charge FinancialCharge @relation(fields: [chargeId], references: [id])
  asset MediaAsset @relation(fields: [mediaAssetId], references: [id])
  @@index([chargeId, createdAt])
  @@map("financial_documents")
}
