{
  "name": "@cisne/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test:auth": "dotenv -e ../../.env -- tsx test/auth.smoke.ts",
    "start": "node dist/server.js",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:seed": "dotenv -e ../../.env -- prisma db seed",
    "backfill:member-users": "dotenv -e ../../.env -- tsx src/scripts/backfill-member-users.ts",
    "test:club-modules": "dotenv -e ../../.env -- tsx test/club-modules.smoke.ts",
    "test:visitor-invitations": "tsx test/visitor-invitations.rules.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.1",
    "@prisma/client": "^6.19.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
